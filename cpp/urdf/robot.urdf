<?xml version="1.0"?>
<robot name="self_balancing_robot">


  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.2 0.8 1"/>
  </material>


  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.10"
        ixy="0.0"
        ixz="0.0"
        iyy="0.10"
        iyz="0.0"
        izz="0.10"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.25 0.15 0.30"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.25 0.15 0.50"/>
      </geometry>
    </collision>

  </link>

  <link name="left_wheel">

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.002"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.002"/>
    </inertial>

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

  </link>


  <link name="right_wheel">

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.002"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.002"/>
    </inertial>

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

  </link>


  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.12 0.10"/>
    <axis xyz="0 1 0"/>

  </joint>


  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.12 0.10"/>
    <axis xyz="0 1 0"/>

  </joint>


  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.25"/>
  </joint>

<gazebo>
  <plugin filename="libgz_ros2_control-system.so"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    
  </plugin>
</gazebo>

</robot>