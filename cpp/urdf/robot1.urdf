<?xml version="1.0"?>
<robot name="four_wheel_robot">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.60 0.45 0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.60 0.45 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.50" ixy="0" ixz="0"
               iyy="0.70" iyz="0"
               izz="0.80"/>
    </inertial>
  </link>

  <link name="wheel_fl">
    <visual>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="wheel_fr">
    <visual>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="wheel_rl">
    <visual>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="wheel_rr">
    <visual>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
<link name="slider">

  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.5 0.4 0.001"/>
    </geometry>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.5 0.4 0.009"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1.0"/>

    <inertia
      ixx="0.01336"
      ixy="0.0"
      ixz="0.0"
      iyy="0.02084"
      iyz="0.0"
      izz="0.03417"/>
  </inertial>

</link>
  <joint name="front" type="prismatic">
    <parent link="base_link"/>
    <child link="slider"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.07" upper="0.25" effort="10" velocity="2"/>
    <origin xyz="0.55 0 -0.25"/>
  </joint>
<link name="support1">

  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 0.01 0.55"/>
    </geometry>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 0.01 0.55"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1.0"/>

    <inertia
      ixx="0.02528"
      ixy="0.0"
      ixz="0.0"
      iyy="0.02554"
      iyz="0.0"
      izz="0.00004"/>
  </inertial>
</link>
  <joint name="s1" type="fixed">
    <parent link="base_link"/>
    <child link="support1"/>
    <origin xyz="0.31 0.21 -0.03" rpy="0 0 0"/>
  </joint>
  <link name="support2">

  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 0.01 0.55"/>
    </geometry>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 0.01 0.55"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1.0"/>

    <inertia
      ixx="0.02528"
      ixy="0.0"
      ixz="0.0"
      iyy="0.02554"
      iyz="0.0"
      izz="0.00004"/>
  </inertial>
</link>
  <joint name="s2" type="fixed">
    <parent link="base_link"/>
    <child link="support2"/>
    <origin xyz="0.31 -0.21 -0.03" rpy="0 0 0"/>
  </joint>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.22 0.25 -0.22"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.22 -0.25 -0.22"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.22 0.25 -0.22"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.22 -0.25 -0.22"/>
    <axis xyz="0 1 0"/>
  </joint>


  <link name="lidar">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0"
               izz="0.0006"/>
    </inertial>
  </link>

  <joint name="lund" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.094" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
  <visual>
    <geometry>
      <box size="0.05 0.05 0.05"/>
    </geometry>
    <material name="black">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
  </visual>

  <collision>
    <geometry>
      <box size="0.05 0.05 0.05"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.1"/>
    <origin xyz="0 0 0"/>
    <inertia
      ixx="0.0001"
      iyy="0.0001"
      izz="0.0001"
      ixy="0"
      ixz="0"
      iyz="0"/>
  </inertial>
</link>

<joint name="camera_joint" type="fixed">
  <parent link="base_link"/>
  <child link="camera_link"/>
  <origin xyz="0.30 0 0.15" rpy="0 0 0"/>
</joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="wheel_fl_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_fr_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_rl_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_rr_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.50</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_fl_joint</joint_name>
      <joint_name>wheel_fr_joint</joint_name>
      <joint_name>wheel_rl_joint</joint_name>
      <joint_name>wheel_rr_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/iamironman/ros2/src/cpp/config/config.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="lidar">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <topic>scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
  <sensor name="depth_camera" type="depth_camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>

    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R_FLOAT32</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>5.0</far>
      </clip>
    </camera>

    <topic>camera</topic>

  </sensor>
</gazebo>

<gazebo reference="camera_link">
  <sensor name="rgb_camera" type="camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>

    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>10.0</far>
      </clip>
    </camera>

    <topic>camera/rgb</topic>

  </sensor>
</gazebo>
<link name="photo_sensor_link">
  <visual>
    <geometry>
      <box size="0.02 0.02 0.02"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.02 0.02 0.02"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.01"/>
    <origin xyz="0 0 0"/>
    <inertia
      ixx="0.00001"
      ixy="0"
      ixz="0"
      iyy="0.00001"
      iyz="0"
      izz="0.00001"/>
  </inertial>
</link>

<joint name="photo_sensor_joint" type="fixed">
  <parent link="base_link"/>
  <child link="photo_sensor_link"/>
  <origin xyz="0.15 0 0.05" rpy="0 0 0"/>
</joint>

<gazebo reference="photo_sensor_link">

  <sensor name="photo_sensor" type="ray">

    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>

    <ray>

      <scan>
        <horizontal>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.01</min>
        <max>1.0</max>
        <resolution>0.001</resolution>
      </range>

    </ray>

    <plugin
      name="gazebo_ros_ray_sensor"
      filename="libgazebo_ros_ray_sensor.so">

      <ros>
        <namespace>/photo_sensor</namespace>
        <remapping>~/out:=scan</remapping>
      </ros>

      <output_type>sensor_msgs/LaserScan</output_type>

      <frame_name>photo_sensor_link</frame_name>

    </plugin>

  </sensor>

</gazebo>
</robot>