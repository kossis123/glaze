<?xml version="1.0"?>
<robot name="box">

  <link name="box_link">

    <!-- VISUAL -->
    <visual>
      <geometry>
        <box size="0.3 0.3 0.3"/>
      </geometry>
    </visual>

    <!-- COLLISION -->
    <collision>
      <geometry>
        <box size="0.3 0.3 0.3"/>
      </geometry>
    </collision>

    <!-- INERTIAL -->
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.5" iyy="0.5" izz="0.5"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>

  </link>

  <!-- 🔥 GAZEBO FRICTION SETTINGS (IMPORTANT) -->
  <gazebo reference="box_link">
    <mu1>3.0</mu1>
    <mu2>3.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>