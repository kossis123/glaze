<joint name="sick_sensor_joint2" type="fixed">
    <parent link="base_8"/>
    <child link="sickx"/>
    <origin xyz="0.2 0 -0.06" rpy="0 0 -1.57"/>
</joint>



  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="wheel1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel3_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel4_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="slider_b1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
<joint name="slider_joint">
  <param name="mimic">slider_b1_joint</param>
  <param name="multiplier">1.0</param>
  <state_interface name="position"/>
  <state_interface name="velocity"/>
</joint>

    <joint name="roller1">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="roller2">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/iamironman/ros2/src/robo/config/config.yaml</parameters>
    </plugin>
  </gazebo>

<gazebo reference="sickx">

<sensor name="gpu_lidar" type="gpu_lidar">
  <pose>0 0 0.2 0 0 0</pose>

  <topic>/distance_x</topic>
  <update_rate>20</update_rate>
  <always_on>true</always_on>
  <visualize>true</visualize>

  <lidar>
    <scan>
      <horizontal>
        <samples>10</samples>
        <resolution>1</resolution>
        <min_angle>0</min_angle>
        <max_angle>0</max_angle>
      </horizontal>

      <vertical>
        <samples>1</samples>
        <resolution>1</resolution>
        <min_angle>0</min_angle>
        <max_angle>0</max_angle>
      </vertical>
    </scan>

    <range>
      <min>0.05</min>
      <max>10.0</max>
      <resolution>0.001</resolution>
    </range>
  </lidar>
</sensor>

</gazebo>

<!-- SENSOR 2: Lidar pointing to side (Y direction) - SINGLE RAY, 90° rotated -->
<gazebo reference="sicky">

<sensor name="gpu_lidar2" type="gpu_lidar">
  <pose>0 0 0.15 0 0 0</pose>

  <topic>/distance_y</topic>
  <update_rate>20</update_rate>
  <always_on>true</always_on>
  <visualize>true</visualize>

  <lidar>
    <scan>
      <horizontal>
        <samples>10</samples>
        <resolution>1</resolution>
        <min_angle>0</min_angle>
        <max_angle>0</max_angle>
      </horizontal>

      <vertical>
        <samples>1</samples>
        <resolution>1</resolution>
        <min_angle>0</min_angle>
        <max_angle>0</max_angle>
      </vertical>
    </scan>

    <range>
      <min>0.05</min>
      <max>10.0</max>
      <resolution>0.001</resolution>
    </range>
  </lidar>
</sensor>
</gazebo>

</robot>