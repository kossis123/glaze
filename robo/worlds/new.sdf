            <box>
              <size>0.15 6 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.15 6 0.5</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- LEVEL 1 WEST WALL -->
    <model name="level1_west_wall">
      <static>true</static>
      <link name="wall_link">
        <pose>-2.925 0 1.25 0 0 0</pose>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.15 6 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.15 6 0.5</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- LEVEL 2 NORTH WALL -->
    <model name="level2_north_wall">
      <static>true</static>
      <link name="wall_link">
        <pose>0 1.425 2.25 0 0 0</pose>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>3 0.15 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.8 1</ambient>
            <diffuse>0.1 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>3 0.15 0.5</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- LEVEL 2 SOUTH WALL -->
    <model name="level2_south_wall">
      <static>true</static>
      <link name="wall_link">
        <pose>0 -1.425 2.25 0 0 0</pose>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>3 0.15 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.8 1</ambient>
            <diffuse>0.1 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>3 0.15 0.5</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- LEVEL 2 EAST WALL -->
    <model name="level2_east_wall">
      <static>true</static>
      <link name="wall_link">
        <pose>1.425 0 2.25 0 0 0</pose>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.15 3 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.8 1</ambient>
            <diffuse>0.1 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.15 3 0.5</size>
            </box>
          </geometry>
        </collision>
      </link>
