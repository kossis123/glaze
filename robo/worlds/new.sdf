    <!-- LEVEL 2 WEST WALL -->
    <model name="level2_west_wall">
      <static>true</static>
      <link name="wall_link">
        <pose>-1.425 0 2.25 0 0 0</pose>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.15 3 0.5</size>
