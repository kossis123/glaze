              <radius>0.0050000000000000001</radius>
              <length>0.10000000000000001</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='cylinder_visual'>
          <geometry>
            <cylinder>
              <radius>0.0080000000000000002</radius>
              <length>0.10000000000000001</length>
            </cylinder>
          </geometry>
          <material>
    <ambient>1 0 0 1</ambient>
    <diffuse>1 0 0 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>false</static>
      <self_collide>false</self_collide>
    </model>

    <model name='cylinder_0'>
      <pose>1.39607 0.443642 0.499999 0 -0 -0</pose>
      <link name='cylinder_link'>
        <inertial>
  <inertia>
            <ixx>8.3957999999999998e-05</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>8.3957999999999998e-05</iyy>
            <iyz>0</iyz>
