<?xml version="1.0"?>

<robot name="red_box">

  <link name="box_link">


    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.5"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>


    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>

      <inertia
          ixx="0.10422"
          ixy="0.0"
          ixz="0.0"
          iyy="0.10422"
          iyz="0.0"
          izz="0.00025"/>
    </inertial>

  </link>

  
  <gazebo reference="box_link">

    <gravity>true</gravity>
    <selfCollide>false</selfCollide>

    <mu1>100</mu1>
    <mu2>100</mu2>

    <kp>1000000.0</kp>
    <kd>100.0</kd>

    <maxContacts>20</maxContacts>

  </gazebo>

</robot>